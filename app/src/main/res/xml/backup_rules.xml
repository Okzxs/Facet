<?xml version="1.0" encoding="utf-8"?>
<!--
  Резервное копирование Android 11 и ниже.
  Исключаем всё содержимое приложения: токены, БД, скачанную музыку и кэш
  нельзя переносить на другое устройство даже через Smart Switch.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
